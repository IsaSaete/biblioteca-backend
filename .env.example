PORT=
DEBUG=
# development en local (registra los enlaces de los correos en consola). Si se
# deja sin definir se asume production, que es lo seguro para un despliegue.
NODE_ENV=development
MONGODB_URI=
FRONTEND_URL=
EXTRA_ALLOWED_ORIGINS=
# Opcionales. Detrás del proxy del frontend: lax, /api y los saltos reales.
# COOKIE_SAME_SITE=none
# API_PUBLIC_PATH_PREFIX=
# TRUST_PROXY_HOPS=1
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
RESEND=
# Opcionales (por defecto, Glosa <no-reply@glosaapp.com> y contacto@glosaapp.com).
# EMAIL_FROM=
# EMAIL_REPLY_TO=
GOOGLE_BOOKS_API_KEY=
